{
  "manifest_version": 3,
  "name": "OpeningsHub Autofill",
  "version": "1.0.0",
  "description": "Fills job application forms (Google Forms, Workday, Greenhouse, Lever, career pages) from your OpeningsHub profile.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpeningsHub Autofill",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://forms.office.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.myworkday.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.darwinbox.in/*",
    "https://*.keka.com/*",
    "https://*.zohorecruit.com/*",
    "https://*.zohorecruit.in/*",
    "https://*.freshteam.com/*",
    "https://*.recruitee.com/*",
    "https://apply.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://*.breezy.hr/*",
    "https://*.jobvite.com/*"
  ],
  "commands": {
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this page from your OpeningsHub profile"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://jatin-29.github.io/general/*"
      ],
      "js": [
        "sync.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://forms.office.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.myworkday.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.darwinbox.in/*",
        "https://*.keka.com/*",
        "https://*.zohorecruit.com/*",
        "https://*.zohorecruit.in/*",
        "https://*.freshteam.com/*",
        "https://*.recruitee.com/*",
        "https://apply.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.jobvite.com/*"
      ],
      "js": [
        "fill.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
