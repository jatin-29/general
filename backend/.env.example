# Telegram (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: python scripts/create_telegram_session.py
TELEGRAM_SESSION_STRING=
# Set false if you run the real-time listener instead of polling
TELEGRAM_POLL_ENABLED=true

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: YouTube Data API v3 key (full descriptions)
YOUTUBE_API_KEY=

# Optional: push new openings to your Telegram chat via a bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

DATABASE_URL=sqlite:///./openingshub.db
POLL_INTERVAL_MINUTES=5
SCHEDULER_ENABLED=true

# Admin key (header X-API-Key). Required for settings, Telegram login, scrape and all writes once set. Choose a long random value.
API_KEY=
FRONTEND_ORIGIN=http://localhost:3000
